<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.jr-database-tools.dbworkbench.examples</groupId>
  <artifactId>examples</artifactId>
  <version>26.1.0</version>
  <packaging>pom</packaging>

  <description>Examples of using PL/SQL Enterprise Workbench Connector Builders.</description>
  <inceptionYear>2015-2026</inceptionYear>

  <properties>
    <!-- encoding -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Pl/Sql Connector Builder -->
    <connectorbuilder-maven-plugin_version>26.1.0</connectorbuilder-maven-plugin_version>

    <!-- oracle jdbc driver -->
    <com.oracle.database.jdbc.ojdbc11-version>23.26.0.0.0</com.oracle.database.jdbc.ojdbc11-version>

    <!-- HikariCP -->
    <com.zaxxer.HikariCP-version>7.0.2</com.zaxxer.HikariCP-version>

    <!-- junit -->
    <org.junit.jupiter_version>5.14.1</org.junit.jupiter_version>

    <build-helper-maven-plugin_version>3.6.1</build-helper-maven-plugin_version>
    <maven-compiler-plugin_version>3.14.1</maven-compiler-plugin_version>
    <maven-surefire-plugin_version>3.5.4</maven-surefire-plugin_version>
    <maven-assembly-plugin_version>3.8.0</maven-assembly-plugin_version>
    <exec-maven-plugin_version>3.6.3</exec-maven-plugin_version>
    <maven-ejb-plugin_version>3.3.0</maven-ejb-plugin_version>
    <maven-dependency-plugin_version>3.9.0</maven-dependency-plugin_version>

    <!-- spring core : 5.2.25.RELEASE support Java versions from 11-25 (incl. Graalvm) -->
    <org.springframework_version>5.2.25.RELEASE</org.springframework_version>

    <!-- java ee 10 -->
    <jakarta.jakartaee-api-version>10.0.0</jakarta.jakartaee-api-version>
  </properties>

  <modules>
    <!-- raw jdbc connector builder -->
    <module>rawjdbc_wrapper</module>

    <!-- java rpc connector builder -->
    <module>java_rpc_connector_builder_factoryapi</module>
    <module>java_rpc_connector_builder_springapi</module>
    <module>java_rpc_connector_builder_xmltype</module>

    <!-- batch/stream connector builder -->
    <module>batch_stream_processor_factoryapi</module>
    <module>batch_stream_processor_springapi</module>

    <!-- jee connector builder -->
<!--    <module>java_ee_factoryapi</module>-->
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- Oracle JDBC Driver -->
      <dependency>
        <groupId>com.oracle.database.jdbc</groupId>
        <artifactId>ojdbc11</artifactId>
        <version>${com.oracle.database.jdbc.ojdbc11-version}</version>
      </dependency>
      <dependency>
        <groupId>com.oracle.database.jdbc</groupId>
        <artifactId>ucp11</artifactId>
        <version>${com.oracle.database.jdbc.ojdbc11-version}</version>
      </dependency>
      <dependency>
        <groupId>com.zaxxer</groupId>
        <artifactId>HikariCP</artifactId>
        <version>${com.zaxxer.HikariCP-version}</version>
      </dependency>
      <dependency>
        <groupId>com.oracle.database.xml</groupId>
        <artifactId>xdb</artifactId>
        <version>${com.oracle.database.jdbc.ojdbc11-version}</version>
      </dependency>
      <dependency>
        <groupId>com.oracle.database.xml</groupId>
        <artifactId>xmlparserv2</artifactId>
        <version>${com.oracle.database.jdbc.ojdbc11-version}</version>
      </dependency>

      <!-- Spring -->
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-context</artifactId>
        <version>${org.springframework_version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-test</artifactId>
        <version>${org.springframework_version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-core</artifactId>
        <version>${org.springframework_version}</version>
      </dependency>

      <!-- Maven -->
      <dependency>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin_version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>${maven-assembly-plugin_version}</version>
      </dependency>

      <!-- JUnit -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-api</artifactId>
        <version>${org.junit.jupiter_version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-params</artifactId>
        <version>${org.junit.jupiter_version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-engine</artifactId>
        <version>${org.junit.jupiter_version}</version>
        <scope>test</scope>
      </dependency>

      <!-- Jakarta EE 10 API -->
      <dependency>
        <groupId>jakarta.platform</groupId>
        <artifactId>jakarta.jakartaee-api</artifactId>
        <version>${jakarta.jakartaee-api-version}</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin_version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin_version}</version>
          <configuration>
            <systemProperties>
              <property>
                <name>dbw_examples.url</name>
                <value>${dbw_examples.url}</value>
              </property>
              <property>
                <name>dbw_examples.username</name>
                <value>${dbw_examples.username}</value>
              </property>
              <property>
                <name>dbw_examples.password</name>
                <value>${dbw_examples.password}</value>
              </property>
            </systemProperties>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin_version}</version>
        </plugin>

        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${build-helper-maven-plugin_version}</version>
          <executions>
            <execution>
              <id>add-source</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>add-source</goal>
              </goals>
              <configuration>
                <sources>
                  <source>target/generated-sources/connector</source>
                </sources>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>com.jr-database-tools.dbworkbench</groupId>
          <artifactId>connectorbuilder-maven-plugin</artifactId>
          <version>${connectorbuilder-maven-plugin_version}</version>
          <executions>
            <execution>
              <phase>generate-sources</phase>
              <goals>
                <goal>run</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin_version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-ejb-plugin</artifactId>
          <version>${maven-ejb-plugin_version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
